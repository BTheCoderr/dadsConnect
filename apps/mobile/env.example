# DadConnect mobile environment template
# Copy to apps/mobile/.env and replace the placeholders with the
# DadConnect Supabase project's public connection values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SCHEME=dadconnect
